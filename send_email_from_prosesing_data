soup = BeautifulSoup(bodyEmail, "html.parser")

rag_colors = {
    "RED": ("#d93025", "#ffffff"),
    "YELLOW": ("#f4b400", "#222222"),
    "AMBER": ("#f4b400", "#222222"),
    "GREEN": ("#3d8b40", "#ffffff")
}

for cell in soup.select(".rag-status"):
    status = cell.get_text(strip=True).upper()

    if status in rag_colors:
        background_color, text_color = rag_colors[status]
        existing_style = cell.get("style", "")
        cell["style"] = (
            existing_style
            + f"background-color:{background_color} !important;"
            + f"color:{text_color} !important;"
            + "font-weight:bold;text-align:center;"
        )
        # bgcolor sebagai fallback untuk renderer Outlook/Word.
        cell["bgcolor"] = background_color

