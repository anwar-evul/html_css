chat_only = chat_only[~chat_only['Group ID'].str.contains('Group ID', case=False, na=False)]
hasil = chat_only.groupby(['Group ID','Session ID'])['End Date Time (HH:MM:SS)'].nunique()
# hasil di left join
chat_only = chat_only.merge(hasil, on=['Group ID','Session ID'], how='left')

fix_chat = pd.merge(chat_sing,chat_only[['Session ID','Group ID','End Date Time (HH:MM:SS)_y']], on=['Session ID','Group ID'], how='left')
fix_chat = fix_chat.drop_duplicates(subset = ['index'], keep = "last")

fix_chat = fix_chat.rename(columns={"End Date Time (HH:MM:SS)_y":"Flag_unique"})

condlist = [(fix_chat['Flag_unique'].isin([1,0])),
            (fix_chat['Flag_unique'] > 1),
            (fix_chat['Flag_unique'].isna())]
choice = ["BLANK_CHAT_CUSTOMER","Any Chat Customer","BLANK_CHAT_CUSTOMER"]
fix_chat['Chat_End_Reason'] = None
fix_chat['Chat_End_Reason'] =np.select(condlist,choice,fix_chat['Chat_End_Reason'])

kolomtoconvert = ['Start Date Time (HH:MM:SS)','End Date Time (HH:MM:SS)','Last Sent Nice Time']
fix_chat[kolomtoconvert] = fix_chat[kolomtoconvert].apply(pd.to_datetime, format="%Y-%m-%d %H:%M:%S")
fix_chat['DATE'] = fix_chat['Start Date Time (HH:MM:SS)'].dt.date
fix_chat['Month'] = fix_chat['DATE'].apply(lambda x: x.strftime('%Y%m'))
fix_chat['quarter'] = pd.PeriodIndex(fix_chat['DATE'], freq='Q')
# extract hour
fix_chat['hour'] = fix_chat['Start Date Time (HH:MM:SS)'].dt.hour
fix_chat['Half_Day_Flag'] = np.where(fix_chat['hour'] < 12, 'firsthalf', 'secondhalf')
fix_chat['Chat_End_Reason'] = np.where(fix_chat['Chat_End_Reason']=='Any Chat Customer', fix_chat['Chat End Reason'],fix_chat['Chat_End_Reason'])
disc_chat = fix_chat.loc[fix_chat['Chat_End_Reason'].isin(['TIMEOUT_END_SESSION','KAI_END_SESSION','BLANK_CHAT_CUSTOMER'])]
fix_chat['Using_percentile'] = '90%'

#%%
pivot_table = fix_chat.pivot_table(index=['Chat_End_Reason'], columns='Month', values='index', aggfunc='count', fill_value=0)
# Calculate column-wise percentages
pivot_table_col_pct = pivot_table.div(pivot_table.sum(axis=0), axis=1) * 100
select_monthyear = pivot_table_col_pct.reset_index()
select_monthyear = select_monthyear.loc[select_monthyear["Chat_End_Reason"].isin(['TIMEOUT_END_SESSION','KAI_END_SESSION','BLANK_CHAT_CUSTOMER'])]

pvt_quarter = (fix_chat.loc[fix_chat['quarter']==q_base]).pivot_table(index=['DATE'], columns=['Chat_End_Reason'], values='index', aggfunc='count', fill_value=0)

pvt_quarter_col_pct = pvt_quarter.div(pvt_quarter.sum(axis=1), axis=0) * 100
custom_percentiles = [.90]
##
described_df = pvt_quarter_col_pct[['TIMEOUT_END_SESSION','KAI_END_SESSION','BLANK_CHAT_CUSTOMER']].describe(percentiles=custom_percentiles).query("index == '90%'").reset_index(drop=True)
