# Generate html_dashboard dari hasil akhir monitor_rpt_day
def generate_html_dashboard(monitor_rpt_day, select_monthyear, output_file=None):
    """
    Membuat dashboard HTML dari monitor_rpt_day.
    File akan disimpan sebagai 'html_dashboard' di folder yang sama
    dengan script prosesing_data.
    """
    if monitor_rpt_day.empty:
        print("monitor_rpt_day kosong. html_dashboard tidak dibuat.")
        return

    # monitor_rpt_day sudah di-transpose oleh monitor_report().
    # Setiap kolom merepresentasikan satu tanggal report.
    report_date = monitor_rpt_day.columns[-1]
    report_date_text = pd.to_datetime(report_date).strftime('%d/%m/%Y')

    def get_value(row_name):
        if row_name not in monitor_rpt_day.index:
            return "-"
        return str(monitor_rpt_day.loc[row_name].iloc[-1])

    rows = [
        {
            "reason": "TIMEOUT_END_SESSION",
            "value": get_value("TIMEOUT_END_SESSION"),
            "threshold": get_value("THRESHOLD_TIMEOUT_END_SESSION"),
            "rag": get_value("STATUS_TIMEOUT")
        },
        {
            "reason": "KAI_END_SESSION",
            "value": get_value("KAI_END_SESSION"),
            "threshold": get_value("THRESHOLD_KAI_END_SESSION"),
            "rag": get_value("STATUS_KAI")
        },
        {
            "reason": "BLANK_CHAT_CUSTOMER",
            "value": get_value("BLANK_CHAT_CUSTOMER"),
            "threshold": get_value("THRESHOLD_BLANK_CHAT"),
            "rag": get_value("STATUS_BLANK")
        }
    ]

    table_rows = ""
    for row in rows:
        rag = row["rag"].strip()
        table_rows += f"""
                <tr>
                    <td>{row["reason"]}</td>
                    <td>{row["value"]}</td>
                    <td>{row["threshold"]}</td>
                    <td class="rag-status">{rag}</td>
                </tr>
"""

    month_df = select_monthyear.copy()
    month_columns = [col for col in month_df.columns if col != "Chat_End_Reason"]
    month_header_html = ""
    for col in month_columns:
        try:
            month_label = pd.to_datetime(str(col), format="%Y%m").strftime("%b %Y")
        except Exception:
            month_label = str(col)
        month_header_html += f"<th>{month_label}</th>"

    month_rows_html = ""
    for _, month_row in month_df.iterrows():
        month_rows_html += "<tr>"
        month_rows_html += f'<td>{month_row["Chat_End_Reason"]}</td>'
        for col in month_columns:
            value = month_row[col]
            value_text = "-" if pd.isna(value) else f"{float(value):.2f}%"
            month_rows_html += f"<td>{value_text}</td>"
        month_rows_html += "</tr>"

    html = f"""<!DOCTYPE html>
