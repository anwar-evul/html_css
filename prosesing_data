def get_quarter(input_date):
    """
    Calculates the quarter of the year for a given date.
    Returns an integer (1, 2, 3, or 4).
    """
    return (input_date.month - 1) // 3 + 1
q_yesterday = get_quarter(yesterday)
q_base = q_yesterday - 1
q_base = f"{yesterday.strftime('%Y')}" + f"Q{q_base}"

#%%
start_date = PreviousMonth1
end_date = yesterday
date_range = pd.date_range(start=start_date, end=end_date)
month_range = pd.period_range(start=start_date, end=end_date, freq='M')
path_call_detail = r'\\10.232.27.11\cctr$\Report\00. Data Source\03_IVR\Chat Interaction Report'

chat_i = pd.DataFrame()
for period in month_range:
    file_name = f"{period.strftime('%Y%m')}.pkl"
