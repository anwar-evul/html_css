        data = pd.read_pickle(file_path, compression='zip')  
        data['Session ID'] = data['Session ID'].ffill()
        data['Chat End Reason'] = data['Chat End Reason'].ffill()
        chat_i = pd.concat([data,chat_i], ignore_index=True)


chat_int = chat_i.loc[chat_i['Chat End Reason'].notna()] 
chat_int['session_flag'] = chat_int['Session ID'].str[:25]
chat_sing = chat_int.loc[chat_int['Agent ID'].notna()] 
chat_sing = fung_index(chat_sing)

chat_only = chat_int.loc[chat_int['Agent ID'].isna()] 
# takeout_list = 'You are now chatting with'
