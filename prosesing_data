#untuk report berjalan
day_df = fix_chat.loc[fix_chat['Month']==f"{yesterday.strftime('%Y%m')}"]
day_df = day_df.pivot_table(index=['DATE'], columns='Chat_End_Reason', values='index', aggfunc='count', fill_value=0)

pvt_day_col_pct = day_df[['TIMEOUT_END_SESSION','KAI_END_SESSION','BLANK_CHAT_CUSTOMER']].div(day_df.sum(axis=1), axis=0) * 100

pvt_day_col_pct['THRESHOLD_TIMEOUT_END_SESSION'] = described_df['TIMEOUT_END_SESSION'].iloc[0]
pvt_day_col_pct['THRESHOLD_KAI_END_SESSION'] = described_df['KAI_END_SESSION'].iloc[0]
pvt_day_col_pct['THRESHOLD_BLANK_CHAT'] = described_df['BLANK_CHAT_CUSTOMER'].iloc[0]

pvt_day_col_pct['STATUS_TIMEOUT'] = np.where(pvt_day_col_pct['TIMEOUT_END_SESSION'] >= pvt_day_col_pct['THRESHOLD_TIMEOUT_END_SESSION'], 'Red','Green')
pvt_day_col_pct['STATUS_KAI'] = np.where(pvt_day_col_pct['KAI_END_SESSION'] >= pvt_day_col_pct['THRESHOLD_KAI_END_SESSION'], 'Red','Green')
pvt_day_col_pct['STATUS_BLANK'] = np.where(pvt_day_col_pct['BLANK_CHAT_CUSTOMER'] >= pvt_day_col_pct['THRESHOLD_BLANK_CHAT'], 'Red','Green')
pvt_day_col_pct =pvt_day_col_pct[['TIMEOUT_END_SESSION','THRESHOLD_TIMEOUT_END_SESSION','KAI_END_SESSION','THRESHOLD_KAI_END_SESSION','BLANK_CHAT_CUSTOMER','THRESHOLD_BLANK_CHAT','STATUS_TIMEOUT','STATUS_KAI','STATUS_BLANK']]
pvt_day_col_pct = pvt_day_col_pct.reset_index()

monitor_rpt_day = pvt_day_col_pct.loc[(pvt_day_col_pct['DATE'] >= dt_report) & (pvt_day_col_pct['DATE'] <= yesterday)]
def monitor_report(monitor_rpt_day):
    cols = ['TIMEOUT_END_SESSION',
            'KAI_END_SESSION',
            'BLANK_CHAT_CUSTOMER',
        'THRESHOLD_TIMEOUT_END_SESSION',
        'THRESHOLD_KAI_END_SESSION',
        'THRESHOLD_BLANK_CHAT'
    ]
    monitor_rpt_day[cols] = monitor_rpt_day[cols].applymap(lambda x: f"{x:.2f}%")
    monitor_rpt_day = monitor_rpt_day.T
    monitor_rpt_day.columns = monitor_rpt_day.iloc[0]
    monitor_rpt_day = monitor_rpt_day.iloc[1:]
    return monitor_rpt_day
monitor_rpt_day = monitor_report(monitor_rpt_day)


