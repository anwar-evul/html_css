import pandas as pd
import numpy as np
from datetime import date, timedelta
import sys
import os
def fung_index(df):
    df = df.reset_index()
    df = df.drop(["index"], axis=1)
    df = df.reset_index()
    return df
today = date.today() 

yesterday = today - timedelta(1)
date_html = yesterday.strftime('%b %Y')
Holidays = pd.read_excel(r"\\10.232.27.11\cctr$\Report\Scripts\Holidays.xlsx", dtype=object)
